#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

packages=(
  build-essential
  ca-certificates
  chromium
  chromium-driver
  chromium-sandbox
  curl
  libsqlite3-dev
  libssl-dev
)

if ! command -v node >/dev/null 2>&1; then
  packages+=(nodejs)
fi

missing_packages=()
for package in "${packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q '^install ok installed$'; then
    missing_packages+=("$package")
  fi
done

if ((${#missing_packages[@]})); then
  echo "==> Installing system packages: ${missing_packages[*]}"
  time sudo apt-get update
  time sudo apt-get install -y --no-install-recommends "${missing_packages[@]}"
else
  echo "==> System packages are already installed"
fi

echo "==> Installing Ruby toolchain"
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
if ! command -v mise >/dev/null 2>&1; then
  curl --fail --silent --show-error --location https://mise.run | sh
fi
time MISE_RUBY_COMPILE=false mise use --global ruby@3.4.12

ruby_path='export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"'
if ! grep -Fqx "$ruby_path" "$HOME/.bash_profile" 2>/dev/null; then
  printf '\n%s\n' "$ruby_path" >> "$HOME/.bash_profile"
fi

echo "==> Installing Ruby dependencies"
bundle config set --local path .bundle
if bundle check >/dev/null 2>&1; then
  echo "Ruby dependencies are already installed"
else
  time bundle install --jobs "$(nproc)" --retry 3
fi

echo "==> MailCatcher orb setup complete"
